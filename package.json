{
  "name": "dashboards-on-demand-refresh-interview",
  "version": "0.1.0",
  "private": true,
  "description": "Backend coding interview: implement a rate-limited on-demand-refresh endpoint on a Dashboards service.",
  "main": "dist/server.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only -r tsconfig-paths/register src/server.ts",
    "build": "tsc -p .",
    "start": "node -r tsconfig-paths/register dist/server.js",
    "type-check": "tsc --noEmit",
    "lint": "eslint . --ext .ts --max-warnings=0",
    "format": "prettier --write ."
  },
  "dependencies": {
    "axios": "^1.7.7",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.16.10",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.3.3",
    "ts-node-dev": "^2.0.0",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.6.3"
  }
}
